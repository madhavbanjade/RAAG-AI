# Copy this file to .env and fill in real values.
# cp .env.example .env

# ---- Required ----

# MongoDB Atlas (or any Mongo) connection string.
# Atlas: make sure your current IP is whitelisted under Network Access,
# or use 0.0.0.0/0 for local dev/testing.
MONGODB_URI=

# JWT secret used to sign login tokens (register/login). Use a long random string.
jwtAccessSecret=

# Groq (LLM) credentials.
GROQ_API_KEY=
# Example: llama-3.3-70b-versatile
GROQ_MODEL=

# ---- Needed only if you use reranking ----

# Reranking (Jina AI). Only required if the chat pipeline's rerank step is reached.
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v3

# ---- Optional (safe defaults already in code) ----

# CORS is open to any origin (no auth cookies are used, only bearer tokens),
# so no FRONTEND_URL setting is needed.

# Server port.
PORT=3000

# Not env-driven, just noting the fixed dependencies:
# - Qdrant is hardcoded to localhost:6333 (vector-store.service.ts)
# - Embeddings call Ollama at localhost:11434 with model "bge-m3" (embeddings.service.ts)
